# Configuración para desarrollo local
# Copia este archivo como .env en tu directorio local

ENVIRONMENT=local

# Configuración básica para desarrollo
SECRET_KEY=django-insecure-dev-key-for-local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Base de datos SQLite (automática para desarrollo)
# No necesitas configurar DB_* para local

# Configuración de la aplicación para desarrollo
MAX_LOAN_AMOUNT=50000000
MIN_LOAN_AMOUNT=50000
DEFAULT_INTEREST_RATE=10.0
MAX_PAYMENT_DAYS=60

ENABLE_ADVANCED_REPORTS=False
AUTO_BACKUP_ENABLED=False
BACKUP_RETENTION_DAYS=7
ENABLE_AUDIT_LOG=True
AUDIT_RETENTION_DAYS=7

TIME_ZONE=America/Bogota