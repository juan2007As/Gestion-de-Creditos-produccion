# Configuración para PythonAnywhere (producción)
# Copia este archivo como .env en PythonAnywhere

ENVIRONMENT=production

# Configuración de seguridad (OBLIGATORIA en producción)
SECRET_KEY=tu-secret-key-super-segura-aqui
ALLOWED_HOSTS=tu-usuario.pythonanywhere.com,tu-dominio.com

# Base de datos PostgreSQL (proporcionada por PythonAnywhere)
DB_NAME=tu_usuario$proyecto_john
DB_USER=tu_usuario
DB_PASSWORD=tu_password_db
DB_HOST=tu_usuario.mysql.pythonanywhere-services.com
DB_PORT=3306

# Email configuration (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=noreply@tu-dominio.com

# Configuración de la aplicación
MAX_LOAN_AMOUNT=10000000
MIN_LOAN_AMOUNT=100000
DEFAULT_INTEREST_RATE=15.0
MAX_PAYMENT_DAYS=30

ENABLE_ADVANCED_REPORTS=True
AUTO_BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
ENABLE_AUDIT_LOG=True
AUDIT_RETENTION_DAYS=365

TIME_ZONE=America/Bogota