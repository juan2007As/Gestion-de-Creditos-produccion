# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y configura tus valores

# ============= CONFIGURACIÓN DE AMBIENTE =============
# Opciones: 'local', 'staging', 'production'
ENVIRONMENT=local

# ============= CONFIGURACIÓN BÁSICA =============
SECRET_KEY=django-insecure-dev-key-change-in-production-123456789
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ============= BASE DE DATOS (PostgreSQL para staging/production) =============
DB_NAME=proyecto_john
DB_USER=django_user
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=5432

# ============= CONFIGURACIÓN DE EMAIL (solo producción) =============
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=tu-email@gmail.com

# ============= CONFIGURACIÓN DE CACHE (Redis opcional) =============
REDIS_URL=redis://127.0.0.1:6379/1

# ============= CONFIGURACIÓN DE LA APLICACIÓN =============
MAX_LOAN_AMOUNT=10000000
MIN_LOAN_AMOUNT=100000
DEFAULT_INTEREST_RATE=15.0
MAX_PAYMENT_DAYS=30

# Configuración de funcionalidades
ENABLE_ADVANCED_REPORTS=False
AUTO_BACKUP_ENABLED=False
BACKUP_RETENTION_DAYS=30
ENABLE_AUDIT_LOG=True
AUDIT_RETENTION_DAYS=30

# ============= CONFIGURACIÓN DE TIEMPO =============
TIME_ZONE=America/Bogota