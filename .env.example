# ============================================================================
# CONFIGURACIÓN DEL PROYECTO - GESTIÓN DE PRÉSTAMOS
# ============================================================================
# Copia este archivo a .env y completa los valores según tu entorno

# ============================================================================
# DJANGO
# ============================================================================
DEBUG=True
SECRET_KEY=tu-clave-secreta-super-larga-y-aleatoria-aqui
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# Idioma y zona (opcional)
LANGUAGE_CODE=es-co
TIME_ZONE=America/Bogota

# ============================================================================
# BASE DE DATOS
# ============================================================================
# SQLite se usa automáticamente cuando DEBUG=True
# Para servidor (DEBUG=False), configurar PostgreSQL:

DB_NAME=proyecto_john
DB_USER=django_user
DB_PASSWORD=tu-password-postgresql
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# GOOGLE DRIVE BACKUPS
# ============================================================================
# Ruta al archivo de credenciales
GOOGLE_DRIVE_CREDENTIALS_PATH=config/google_drive_credentials.json

# Nombre de la carpeta en Google Drive
BACKUP_FOLDER_NAME=GestionPrestamos_Backups

# Número máximo de backups a mantener
MAX_BACKUPS=30

# ============================================================================
# CONFIGURACIÓN DE SEGURIDAD (PRODUCCIÓN)
# ============================================================================
# Para VPS/Producción, cambiar estos valores
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# En producción (VPS):
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ============================================================================
# EMAIL (Backups, notificaciones)
# ============================================================================
# Desarrollo: usar console para no enviar correos reales
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Servidor: usar smtp
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-gmail
DEFAULT_FROM_EMAIL=tu-email@gmail.com
BACKUP_RECIPIENT_EMAIL=juan6722634@gmail.com

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# ============================================================================
# CARACTERÍSTICAS
# ============================================================================
# Habilitar/deshabilitar funcionalidades
BACKUP_AUTOMATICO_HABILITADO=True
AUDITORIA_HABILITADA=True

# ============================================================================
# MORA Y TASAS DE INTERÉS
# ============================================================================
# Estos valores también se guardan en la base de datos (Configuracion)
MORA_DIARIA_DEFAULT=2000.00
TASA_INTERES_NORMAL=15.00
TASA_INTERES_RAPIDA=20.00

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
# 1. Nunca commitear este archivo con valores reales
# 2. Crear .env.local para desarrollo local
# 3. En VPS, configurar variables de entorno del servidor
# 4. Credenciales de Google Drive van en config/google_drive_credentials.json
#    NO deben ir en .env por seguridad
